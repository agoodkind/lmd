+          if ! git -C "$SOURCE_REPO" rev-parse -q --verify "refs/tags/${NEW_TAG}^{commit}" >/dev/null; then
+            echo "::error::tag $NEW_TAG does not exist in $SOURCE_REPO"
+            exit 1
+          fi
+          before=$(git rev-parse "HEAD:$SOURCE_REPO")
+          git -C "$SOURCE_REPO" checkout --detach "refs/tags/$NEW_TAG"
+          after=$(git -C "$SOURCE_REPO" rev-parse HEAD)
+          {
+            echo "BEFORE_SHA=$before"
+            echo "AFTER_SHA=$after"
+          } >> "$GITHUB_ENV"
+          if [ "$before" = "$after" ]; then
+            echo "ALREADY_CURRENT=1" >> "$GITHUB_ENV"
+          fi
+
+      - name: Report an already-current submodule and stop
+        if: env.ALREADY_CURRENT == '1'
+        run: |
+          {
+            echo "### Nothing to bump"
+            echo
+            echo "\`$SOURCE_REPO\` is already at \`$NEW_TAG\` (\`${AFTER_SHA:0:7}\`)."
+          } >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Push a new bump branch
+        if: env.ALREADY_CURRENT != '1'
+        run: |
+          set -euo pipefail
+          branch="auto-update/$SOURCE_REPO-$NEW_TAG"
+          if git ls-remote --exit-code --heads origin "refs/heads/$branch"; then
+            echo "::error::Branch $branch already exists. Review its commits before updating it manually."
+            exit 1
+          else
+            status=$?
+            if [[ "$status" -ne 2 ]]; then
+              echo "::error::Cannot inspect the existing remote branch. Git exited with status $status."
+              exit "$status"
+            fi
+            echo "The remote does not contain $branch."
+          fi
+          git checkout -b "$branch"
+          git add "$SOURCE_REPO"
+          git \
+            -c user.name='github-actions[bot]' \
+            -c user.email='41898282+github-actions[bot]@users.noreply.github.com' \
+            commit -m "Update $SOURCE_REPO submodule to $NEW_TAG"
+          git push origin "HEAD:refs/heads/$branch"
+          echo "BUMP_BRANCH=$branch" >> "$GITHUB_ENV"
+
+      - name: Link to the new pull request form
+        if: env.ALREADY_CURRENT != '1'
+        run: |
+          {
+            echo "### Review the dependency update"
+            echo
+            echo "Branch \`$BUMP_BRANCH\` updates \`$SOURCE_REPO\` from \`$BEFORE_SHA\` to \`$AFTER_SHA\`."
+            echo
+            echo "[Open the pull request]($GITHUB_SERVER_URL/$GITHUB_REPOSITORY/compare/main...$BUMP_BRANCH?expand=1)"
+            echo
+            echo "This workflow does not open pull requests. A person must review and open the branch."
+            echo "Pull requests opened with GITHUB_TOKEN create workflow runs that require approval."
+          } >> "$GITHUB_STEP_SUMMARY"
