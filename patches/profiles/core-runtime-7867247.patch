index 0000000000000000000000000000000000000000..72dd2ec6968b144233e6fed29e088320d6cc02bc
--- /dev/null
+++ b/.github/scripts/upstream-sync.mjs
@@ -0,0 +1,118 @@
+#!/usr/bin/env node
+
+import { execFileSync } from 'node:child_process';
+import { appendFileSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+
+const candidateBranch = 'sync/upstream-latest';
+const stateFile = '.github/upstream-sync-state';
+
+function command(executable, arguments_) {
+  try {
+    return execFileSync(executable, arguments_, {
+      encoding: 'utf8',
+      stdio: ['ignore', 'pipe', 'inherit'],
+    }).trim();
+  } catch (error) {
+    if (error.stdout) process.stderr.write(error.stdout);
+    throw error;
+  }
+}
+
+function git(...arguments_) {
+  return command('git', arguments_);
+}
+
+function requiredEnvironment(name) {
+  const value = process.env[name];
+  if (!value) {
+    throw new Error(`Set ${name} before running upstream synchronization.`);
+  }
+  return value;
+}
+
+function readState() {
+  try {
+    return readFileSync(stateFile, 'utf8').trim();
+  } catch (error) {
+    if (error.code === 'ENOENT') {
+      return null;
+    }
+    throw error;
+  }
+}
+
+function output(name, value) {
+  console.log(`${name}=${value}`);
+  if (process.env.GITHUB_OUTPUT) {
+    appendFileSync(process.env.GITHUB_OUTPUT, `${name}=${value}\n`);
+  }
+}
+
+function sync() {
+  const upstreamURL = requiredEnvironment('SYNC_UPSTREAM_URL');
+  if (git('status', '--porcelain')) {
+    throw new Error('Commit or remove working tree changes before synchronizing.');
+  }
+
+  git('fetch', '--no-tags', 'origin');
+  const candidateRef = `refs/remotes/origin/${candidateBranch}`;
+  const previousCandidate = git('for-each-ref', '--format=%(objectname)', candidateRef);
+  git('fetch', '--no-tags', upstreamURL, 'main');
+  const upstreamSHA = git('rev-parse', 'FETCH_HEAD');
+  git('switch', '--detach', previousCandidate || 'origin/main');
+  git('merge', '--no-edit', '-m', 'Merge main into upstream candidate', 'origin/main');
+
+  if (readState() !== upstreamSHA) {
+    git('merge', '--no-edit', '--allow-unrelated-histories',
+      '-m', 'Merge upstream main into sync candidate', upstreamSHA);
+    mkdirSync('.github', { recursive: true });
+    writeFileSync(stateFile, `${upstreamSHA}\n`);
+    git('add', stateFile);
+    git('commit', '-m', `Record upstream main at ${upstreamSHA}`);
+  }
+
+  const headSHA = git('rev-parse', 'HEAD');
+  const hasChanges = git('rev-list', '--count', 'origin/main..HEAD') !== '0';
+  if (hasChanges && headSHA !== previousCandidate) {
+    git('push', 'origin', `HEAD:refs/heads/${candidateBranch}`);
+  }
+  output('has_changes', hasChanges);
+  output('head_sha', headSHA);
+  output('upstream_sha', upstreamSHA);
+}
+
+function updatePullRequest() {
+  requiredEnvironment('GH_TOKEN');
+  const repository = requiredEnvironment('GITHUB_REPOSITORY');
+  const pullRequests = JSON.parse(command('gh', [
+    'pr', 'list', '--repo', repository, '--base', 'main', '--head', candidateBranch,
+    '--state', 'open', '--json', 'number',
+  ]));
+  if (pullRequests.length > 1) {
+    throw new Error(`Resolve duplicate open pull requests for ${candidateBranch}.`);
+  }
+  const title = 'Sync Apple mlx-swift updates';
+  const body = `Merge Apple mlx-swift main at ${readFileSync(stateFile, 'utf8').trim()}.\n\n`
+    + 'The candidate preserves existing repair commits and merges current main before upstream. '
+    + 'Conflicts stop synchronization. Review the diff and require successful build and integration checks.';
+  if (pullRequests.length === 1) {
+    command('gh', ['pr', 'edit', String(pullRequests[0].number), '--repo', repository,
+      '--title', title, '--body', body]);
+  } else {
+    command('gh', ['pr', 'create', '--repo', repository, '--base', 'main',
+      '--head', candidateBranch, '--title', title, '--body', body]);
+  }
+}
+
+try {
+  if (process.argv[2] === 'sync') {
+    sync();
+  } else if (process.argv[2] === 'pr') {
+    updatePullRequest();
+  } else {
+    throw new Error('Run upstream-sync.mjs with sync or pr.');
+  }
+} catch (error) {
+  console.error(`Upstream synchronization failed: ${error.message}`);
+  process.exitCode = 1;
+}
diff --git a/.github/scripts/upstream-sync.test.mjs b/.github/scripts/upstream-sync.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2d13a800b535673832b54a5510e765fe4fa007ec
--- /dev/null
+++ b/.github/scripts/upstream-sync.test.mjs
@@ -0,0 +1,110 @@
+#!/usr/bin/env node
+
+import assert from 'node:assert/strict';
+import { execFileSync, spawnSync } from 'node:child_process';
+import { mkdtempSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import test from 'node:test';
+
+const helper = fileURLToPath(new URL('./upstream-sync.mjs', import.meta.url));
+const branch = 'sync/upstream-latest';
+const state = '.github/upstream-sync-state';
+
+function git(directory, ...arguments_) {
+  return execFileSync('git', ['-C', directory, ...arguments_], {
+    encoding: 'utf8',
+    stdio: ['ignore', 'pipe', 'pipe'],
+    env: { ...process.env, GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: '/dev/null' },
+  }).trim();
+}
+
+function initialize(directory, bare = false) {
+  mkdirSync(directory);
+  const arguments_ = ['init', '--initial-branch=main'];
+  if (bare) arguments_.push('--bare');
+  git(directory, ...arguments_);
+  if (!bare) {
+    git(directory, 'config', 'user.name', 'Sync Test');
+    git(directory, 'config', 'user.email', 'sync-test@example.invalid');
+  }
+}
+
+function commit(directory, filename, contents) {
+  writeFileSync(join(directory, filename), contents);
+  git(directory, 'add', filename);
+  git(directory, 'commit', '-m', `Update ${filename}`);
+  return git(directory, 'rev-parse', 'HEAD');
+}
+
+test('synchronization preserves repairs and rejects conflicts before publishing', () => {
+  const root = mkdtempSync(join(tmpdir(), 'upstream-sync-'));
+  const origin = join(root, 'origin.git');
+  const upstream = join(root, 'upstream');
+  const main = join(root, 'main');
+  const worker = join(root, 'worker');
+  initialize(origin, true);
+  initialize(upstream);
+  initialize(main);
+  mkdirSync(join(main, '.github'));
+  commit(main, 'fork.txt', 'fork\n');
+  commit(main, 'shared.txt', 'original\n');
+  git(main, 'remote', 'add', 'origin', origin);
+  git(main, 'push', 'origin', 'main');
+  commit(upstream, 'upstream.txt', 'upstream\n');
+  const firstUpstream = commit(upstream, 'shared.txt', 'original\n');
+  git(root, 'clone', origin, worker);
+  git(worker, 'config', 'user.name', 'Sync Test');
+  git(worker, 'config', 'user.email', 'sync-test@example.invalid');
+
+  const run = () => spawnSync(process.execPath, [helper, 'sync'], {
+    cwd: worker,
+    encoding: 'utf8',
+    env: { ...process.env, SYNC_UPSTREAM_URL: upstream, GITHUB_OUTPUT: '',
+      GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: '/dev/null' },
+  });
+  const succeed = () => {
+    const result = run();
+    assert.equal(result.status, 0, result.stderr);
+    return result;
+  };
+  const remoteHead = () => git(origin, 'rev-parse', `refs/heads/${branch}`);
+
+  succeed();
+  assert.equal(readFileSync(join(worker, state), 'utf8').trim(), firstUpstream);
+  assert.equal(git(worker, 'show', 'HEAD:fork.txt'), 'fork');
+  assert.equal(git(worker, 'show', 'HEAD:upstream.txt'), 'upstream');
+  assert.equal(remoteHead(), git(worker, 'rev-parse', 'HEAD'));
+  assert.doesNotMatch(git(worker, 'log', '--format=%B', 'origin/main..HEAD'), /\[skip ci\]/);
+
+  const repair = commit(worker, 'manual-repair.txt', 'preserve this repair\n');
+  git(worker, 'push', 'origin', `HEAD:refs/heads/${branch}`);
+  const mainUpdate = commit(main, 'main-update.txt', 'current main\n');
+  git(main, 'push', 'origin', 'main');
+  const nextUpstream = commit(upstream, 'upstream-update.txt', 'new upstream\n');
+  succeed();
+  git(worker, 'merge-base', '--is-ancestor', repair, 'HEAD');
+  git(worker, 'merge-base', '--is-ancestor', mainUpdate, 'HEAD');
+  git(worker, 'merge-base', '--is-ancestor', nextUpstream, 'HEAD');
+  assert.equal(git(worker, 'rev-parse', 'HEAD~1^2'), nextUpstream);
+  assert.equal(git(worker, 'rev-parse', 'HEAD~2^2'), mainUpdate);
+  assert.equal(git(worker, 'show', 'HEAD:manual-repair.txt'), 'preserve this repair');
+  assert.equal(readFileSync(join(worker, state), 'utf8').trim(), nextUpstream);
+
+  const unchangedHead = remoteHead();
+  succeed();
+  assert.equal(remoteHead(), unchangedHead);
+  assert.equal(git(worker, 'rev-parse', 'HEAD'), unchangedHead);
+
+  const conflictingRepair = commit(worker, 'shared.txt', 'fork repair\n');
+  git(worker, 'push', 'origin', `HEAD:refs/heads/${branch}`);
+  commit(upstream, 'shared.txt', 'conflicting upstream\n');
+  const failed = run();
+  assert.notEqual(failed.status, 0);
+  assert.match(failed.stderr, /CONFLICT/);
+  assert.match(failed.stderr, /Upstream synchronization failed/);
+  assert.equal(remoteHead(), conflictingRepair);
+  assert.equal(readFileSync(join(worker, state), 'utf8').trim(), nextUpstream);
+  assert.notEqual(git(worker, 'ls-files', '--unmerged'), '');
+});
