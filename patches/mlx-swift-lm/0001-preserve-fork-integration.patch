+import Foundation
+import MLX
+import MLXLMCommon
+import MLXNN
+import Testing
+
+@testable import MLXVLM
+
+extension MLXTestingSuite {
+    @Suite
+    struct Gemma4VideoTests {
+        @Test("Gemma processor encoding preserves video and audio options")
+        func processorConfigurationRoundTrip() throws {
+            let json = """
+                {
+                  "processor_class": "Gemma4Processor",
+                  "video_token_id": 4,
+                  "video_seq_length": 4,
+                  "video_frame_size": {"width": 4, "height": 4},
+                  "video_max_frames": 2,
+                  "video_fps": 16,
+                  "boa_token_id": 7,
+                  "eoa_token_id": 8,
+                  "audio_token_id": 9
+                }
+                """
+            let decoder = JSONDecoder()
+            let original = try decoder.decode(
+                Gemma4ProcessorConfiguration.self, from: Data(json.utf8))
+            let decoded = try decoder.decode(
+                Gemma4ProcessorConfiguration.self, from: JSONEncoder().encode(original))
+
+            #expect(decoded.videoTokenId == 4)
+            #expect(decoded.videoSoftTokensPerFrame == 4)
+            #expect(decoded.videoSeqLength == 4)
+            #expect(decoded.videoFixedSize == CGSize(width: 4, height: 4))
+            #expect(decoded.videoFrameFixedSize == decoded.videoFixedSize)
+            #expect(decoded.videoMaxFrames == 2)
+            #expect(decoded.videoFps == 16)
+            #expect(decoded.boaTokenId == 7)
+            #expect(decoded.eoaTokenId == 8)
+            #expect(decoded.audioTokenId == 9)
+        }
+
+        @Test("Gemma consumes video pixels across vision chunks", arguments: [true, false])
+        func videoPixelsChangeLogitsAcrossChunks(tieWordEmbeddings: Bool) throws {
+            try withMemoryLimit {
+                let model = Gemma4(try makeConfiguration(tieWordEmbeddings: tieWordEmbeddings))
+                eval(model)
+                let frameCount = 40
+                let pixels =
+                    MLXArray(0 ..< frameCount * 48)
+                    .reshaped([frameCount, 3, 4, 4]).asType(.float32) / 240
+                var tokens: [Int32] = [1]
+                tokens.append(contentsOf: Array(repeating: 61, count: frameCount * 4))
+                tokens.append(2)
+
+                let original = try logits(model, tokens: tokens, video: pixels)
+                let changedPixels = concatenated([
+                    pixels[..<(frameCount - 1)],
+                    MLXArray.zeros([1, 3, 4, 4]),
+                ])
