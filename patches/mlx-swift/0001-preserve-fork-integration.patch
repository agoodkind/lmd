+            self.assertLess(mx.abs(g1 - g2).max().item(), 1e-6)
+
+        w = mx.random.uniform(shape=(4, 7))
+        f3 = lambda x, y: (ref(x, y) * w).sum()
+        f4 = lambda x, y: (mx.fast.cross_entropy(x, y) * w).sum()
