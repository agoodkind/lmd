diff --git a/Source/Cmlx/mlx/mlx/backend/cuda/ptx.cuh b/Source/Cmlx/mlx/mlx/backend/cuda/ptx.cuh
new file mode 100644
index 0000000..b7b87e6
--- /dev/null
