+  CHECK(array_equal(out, array({4.0f, 1.0f, 1.0f, 2.0f})).item<bool>());
+
+  // Single element scatter max
+  in = ones({4}, float32);
+  inds = array({0, 0, 3});
+  updates = array({1.0f, 6.0f, -2.0f}, {3, 1});
+  out = scatter_max(in, inds, updates, 0);
