+  using dict = std::unordered_map<std::string, array>;
+  dict original_weights = {
+      {"test", array({1.0f, 2.0f, 3.0f, 4.0f})},
+      {"test2", reshape(arange(6), {3, 2})}};
+
+  // Scalar array
