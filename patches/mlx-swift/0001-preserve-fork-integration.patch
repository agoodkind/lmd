+          COMPILE_LOCK_REPRO_BINARY: ${{ runner.temp }}/mlx-core-derived/Build/Products/Debug/CompileLockRepro
+        run: node --test .github/scripts/compile-lock-repro.test.mjs
+
+      - name: Upload core regression results
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: core-fork-regressions
+          path: ${{ runner.temp }}/core-fork-regressions.xcresult
+          if-no-files-found: error
