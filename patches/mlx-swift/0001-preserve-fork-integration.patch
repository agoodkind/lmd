+
+        a_mlx = mx.random.randint(shape=(32, 32, 32), low=-100, high=100)
+        for op in ["cumsum", "cumprod", "cummax", "cummin"]:
+            mxop = getattr(mx, op)
+            c1 = mxop(a_mlx, axis=2)
