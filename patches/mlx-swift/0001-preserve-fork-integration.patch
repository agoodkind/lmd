+
+#include "mlx/c/array.h"
+#include "mlx/c/stream.h"
+#include "mlx/c/string.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * \defgroup mlx_vector Vectors
+ * MLX vector objects.
+ */
+/**@{*/
+"""
+
+decl_end = """
+/**@}*/
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
+"""
+
+impl_begin = r"""/* Copyright © 2023-2024 Apple Inc.                   */
