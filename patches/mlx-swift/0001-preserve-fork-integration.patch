+    auto fun = [](std::vector<array> inputs) {
+      return std::vector<array>{inputs[0], inputs[1]};
+    };
+    CHECK_THROWS_AS(
+        jvp(fun, {array(1), array(1)}, {array(1)}), std::invalid_argument);
+  }
+
+  // No dependence between input and output
