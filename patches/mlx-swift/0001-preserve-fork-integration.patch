+    auto a = array({3, 2, 1});
+    auto b = array({1, 1, 1});
+    auto out = subtract(a, b, Device::gpu);
+    CHECK(array_equal(out, array({2, 1, 0}), Device::cpu).item<bool>());
+  }
+
+  // Check multiplication
+  {
+    auto a = array({1, 2, 3});
+    auto b = array({2, 2, 2});
+    auto out = multiply(a, b, Device::gpu);
+    CHECK(array_equal(out, array({2, 4, 6}), Device::cpu).item<bool>());
