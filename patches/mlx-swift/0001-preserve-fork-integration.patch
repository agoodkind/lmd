+#define LOAD_SYMBOL(symbol, variable)                               \
+  {                                                                 \
+    variable = (decltype(variable))dlsym(librdma_handle_, #symbol); \
+    char* error = dlerror();                                        \
+    if (error != nullptr) {                                         \
+      std::cerr << IBV_TAG << " " << error << std::endl;            \
+      librdma_handle_ = nullptr;                                    \
+      return;                                                       \
+    }                                                               \
+  }
