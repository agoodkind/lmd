+
+  // Check equal
+  {
+    array x(1.0f);
+    array y(1.0f);
+    CHECK(equal(x, y, Device::gpu).item<bool>());
+    x = array(0.0f);
+    CHECK(!equal(x, y, Device::gpu).item<bool>());
