+++ b/.github/scripts/verify-spm-manifest.test.mjs
@@ -0,0 +1,33 @@
+#!/usr/bin/env node
+
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, readFileSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import test from 'node:test';
+
+const verifier = fileURLToPath(new URL('../../scripts/verify-spm-manifest.py', import.meta.url));
+const fixture = readFileSync(new URL('../../Tests/ManifestValidationTests/Package.swift', import.meta.url), 'utf8');
+const linux = process.platform === 'linux';
+
+function verify(pluginName) {
+  const directory = mkdtempSync(join(tmpdir(), 'manifest-validation-'));
+  writeFileSync(join(directory, 'Package.swift'), fixture.replaceAll('__PLUGIN_NAME__', pluginName));
+  const result = spawnSync('python3', [verifier], { cwd: directory, encoding: 'utf8' });
+  if (result.error) throw result.error;
+  return result;
+}
+
+test('the platform manifest accepts the required plugin identity', () => {
+  const result = verify(linux ? 'CudaBuild' : 'OtherBuild');
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /SwiftPM manifest CUDA containment passed/);
+});
+
+test('the platform manifest rejects an invalid CUDA plugin binding', () => {
+  const result = verify(linux ? 'OtherBuild' : 'CudaBuild');
+  assert.notEqual(result.status, 0);
+  assert.match(result.stderr, /CUDA build (plugin|targets)/);
+});
diff --git a/.github/workflows/auto_release.yml b/.github/workflows/auto_release.yml
new file mode 100644
index 0000000..a80ecb2
--- /dev/null
+++ b/.github/workflows/auto_release.yml
@@ -0,0 +1,61 @@
+name: Auto Release Pipeline
+
+on:
+  push:
+    branches:
+      - main
+
+permissions:
+  contents: write
+
+jobs:
+  tag-and-release:
+    name: Create SemVer Tag and Release
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout Code
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0 # Essential for retrieving all tags to calculate the next semver bump
+
+      - name: Calculate release version (b<commit_count>)
+        id: tag_version
+        run: |
+          COMMIT_COUNT=$(git rev-list --count HEAD)
+          TAG_NAME="b${COMMIT_COUNT}"
+          echo "Calculated tag: $TAG_NAME"
+          echo "new_tag=$TAG_NAME" >> $GITHUB_OUTPUT
+          
+          # Create and push the tag manually
+          git tag $TAG_NAME
+          git push origin $TAG_NAME
+
+      - name: Create GitHub Release
+        uses: softprops/action-gh-release@v2
+        with:
+          tag_name: ${{ steps.tag_version.outputs.new_tag }}
+          name: Release ${{ steps.tag_version.outputs.new_tag }}
+          body: "Automated release based on commit count ${{ steps.tag_version.outputs.new_tag }}"
+          generate_release_notes: true
+
+      - name: Trigger SwiftLM Dependency Bump
+        uses: actions/github-script@v6
+        env:
+          PR_TOKEN: ${{ secrets.SWIFTLM_PR_TOKEN || secrets.PAT_TOKEN || secrets.GITHUB_TOKEN }}
+        with:
+          github-token: ${{ env.PR_TOKEN }}
+          script: |
+            try {
+              await github.rest.repos.createDispatchEvent({
+                owner: 'SharpAI',
+                repo: 'SwiftLM',
+                event_type: 'dependency_bump',
+                client_payload: {
+                  source_repo: context.repo.repo,
+                  new_tag: '${{ steps.tag_version.outputs.new_tag }}'
+                }
+              });
+              console.log("Successfully dispatched dependency_bump event to SharpAI/SwiftLM");
+            } catch (error) {
+              console.log("Dispatch failed. Ensure SWIFTLM_PR_TOKEN is set in repository secrets with repo scoping.", error);
+            }
diff --git a/.github/workflows/downstream_integration.yml b/.github/workflows/downstream_integration.yml
new file mode 100644
index 0000000..6089e82
--- /dev/null
+++ b/.github/workflows/downstream_integration.yml
@@ -0,0 +1,124 @@
+name: Downstream Integration Test
+
+on:
+  pull_request:
+    branches: [main]
+  workflow_dispatch:
+    inputs:
+      swiftlm_ref:
+        description: Exact SwiftLM commit to validate
+        type: string
+        required: true
+        default: 53ae5b0da17f1b4484de4c01370e0ceb5a4fe079
+      mlx_swift_lm_ref:
+        description: Exact mlx-swift-lm commit to validate
+        type: string
+        required: true
+        default: 74ebe55d0d68de121f730334412da01a539eba50
+
+permissions:
+  contents: read
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  test-swiftlm-umbrella:
+    name: Test with SwiftLM (Umbrella Repo)
+    runs-on: macos-26
+    timeout-minutes: 40
+    env:
+      DEVELOPER_DIR: /Applications/Xcode_26.5.app/Contents/Developer
+      SWIFTLM_REF: ${{ inputs.swiftlm_ref || '53ae5b0da17f1b4484de4c01370e0ceb5a4fe079' }}
+      MLX_SWIFT_LM_REF: ${{ inputs.mlx_swift_lm_ref || '74ebe55d0d68de121f730334412da01a539eba50' }}
+      SWIFTLM_TEST_FILTER: 'SwiftLMTests\.(PromptCacheTests|MultimodalTokenExtractionTests|ChatRequestParsingTests|ThinkingTagStripTests)'
+    steps:
+      - name: Checkout mlx-swift (this repository)
+        uses: actions/checkout@v4
+        with:
+          path: mlx-swift-pr
+          submodules: recursive
+          persist-credentials: false
+
+      - name: Checkout SwiftLM
+        uses: actions/checkout@v4
+        with:
+          repository: agoodkind/SwiftLM
+          ref: ${{ env.SWIFTLM_REF }}
+          path: SwiftLM
+          submodules: recursive
+          persist-credentials: false
+
+      - name: Select exact dependency commits
+        run: |
+          if [[ ! "$SWIFTLM_REF" =~ ^[0-9a-f]{40}$ ]]; then
+            echo "::error::Set swiftlm_ref to a full 40-character commit SHA."
+            exit 1
+          fi
+          if [[ ! "$MLX_SWIFT_LM_REF" =~ ^[0-9a-f]{40}$ ]]; then
+            echo "::error::Set mlx_swift_lm_ref to a full 40-character commit SHA."
+            exit 1
+          fi
+          test "$(git -C SwiftLM rev-parse HEAD)" = "$SWIFTLM_REF"
+          git -C SwiftLM/mlx-swift-lm fetch --quiet origin "$MLX_SWIFT_LM_REF"
+          git -C SwiftLM/mlx-swift-lm checkout --quiet --detach "$MLX_SWIFT_LM_REF"
+          test "$(git -C SwiftLM/mlx-swift-lm rev-parse HEAD)" = "$MLX_SWIFT_LM_REF"
+          git -C SwiftLM/mlx-swift fetch --quiet --no-tags --depth=1 "$GITHUB_WORKSPACE/mlx-swift-pr" HEAD
+          git -C SwiftLM/mlx-swift checkout --quiet --detach FETCH_HEAD
+          test "$(git -C SwiftLM/mlx-swift rev-parse HEAD)" = "$(git -C mlx-swift-pr rev-parse HEAD)"
+          git -C SwiftLM rev-parse HEAD
+          git -C SwiftLM/mlx-swift rev-parse HEAD
+          git -C SwiftLM/mlx-swift-lm rev-parse HEAD
+
+      - name: Build SwiftLM and tests in Debug
+        working-directory: SwiftLM
+        run: swift build --build-system native --jobs 4 --build-tests
+
+      - name: Build Metal library from the selected core checkout
+        run: |
+          xcodebuild -downloadComponent MetalToolchain
+          mkdir -p "$RUNNER_TEMP/mlx-metallib/lib"
+          cmake -S mlx-swift-pr/Source/Cmlx/mlx -B "$RUNNER_TEMP/mlx-metallib" \
+            -DCMAKE_BUILD_TYPE=Release -DMLX_METAL_JIT=OFF \
+            -DMLX_BUILD_TESTS=OFF -DMLX_BUILD_EXAMPLES=OFF \
+            -DMLX_BUILD_BENCHMARKS=OFF -DMLX_BUILD_PYTHON_BINDINGS=OFF \
+            -DMLX_METAL_PATH="$RUNNER_TEMP/mlx-metallib/lib"
+          cmake --build "$RUNNER_TEMP/mlx-metallib" --target mlx-metallib --parallel 4
+          KERNEL_BUILD="$RUNNER_TEMP/mlx-metallib/mlx/backend/metal/kernels"
+          if [[ -f "$KERNEL_BUILD/steel_gemm_fused_nax.air" ]]; then
+            mkdir -p "$RUNNER_TEMP/mlx-metallib/nax"
+            for kernel in steel_gemm_fused_nax steel_gemm_splitk_nax steel_gemm_gather_nax steel_gemm_segmented_nax steel_attention_nax quantized_nax fp_quantized_nax; do
+              xcrun -sdk macosx metal -mmacosx-version-min="$(sw_vers -productVersion)" \
+                "$KERNEL_BUILD/$kernel.air" -o "$RUNNER_TEMP/mlx-metallib/nax/$kernel.metallib"
+            done
+          else
+            echo "CMake did not enable NAX kernels for this SDK and deployment target."
+          fi
+
+      - name: Colocate Metal libraries with the binary and test runner
+        working-directory: SwiftLM
+        run: |
+          BIN_DIR=$(swift build --build-system native --show-bin-path)
+          cp "$RUNNER_TEMP/mlx-metallib/lib/mlx.metallib" "$BIN_DIR/mlx.metallib"
+          for test_bundle in "$BIN_DIR"/*.xctest; do
+            cp "$RUNNER_TEMP/mlx-metallib/lib/mlx.metallib" "$test_bundle/Contents/MacOS/mlx.metallib"
+            if [[ -d "$RUNNER_TEMP/mlx-metallib/nax" ]]; then
+              cp -R "$RUNNER_TEMP/mlx-metallib/nax" "$test_bundle/Contents/MacOS/nax"
+            fi
+          done
+          if [[ -d "$RUNNER_TEMP/mlx-metallib/nax" ]]; then
+            cp -R "$RUNNER_TEMP/mlx-metallib/nax" "$BIN_DIR/nax"
+          fi
+
+      - name: Run tests without pretrained models
+        working-directory: SwiftLM
+        run: |
+          swift test --build-system native --jobs 4 list --skip-build > "$RUNNER_TEMP/swiftlm-tests.txt"
+          for test_class in PromptCacheTests MultimodalTokenExtractionTests ChatRequestParsingTests ThinkingTagStripTests; do
+            if ! grep -F "SwiftLMTests.$test_class/" "$RUNNER_TEMP/swiftlm-tests.txt"; then
+              echo "::error::The selected SwiftLM commit does not provide $test_class."
+              exit 1
+            fi
+          done
+          swift test --build-system native --jobs 4 --skip-build --filter "$SWIFTLM_TEST_FILTER"
