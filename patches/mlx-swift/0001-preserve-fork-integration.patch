+template <typename T>
+void general_inv(T* inv, int N) {
+  int info;
+  auto ipiv = array::Data{allocator::malloc(sizeof(int) * N)};
+  // Compute LU factorization.
+  getrf<T>(
+      /* m = */ &N,
+      /* n = */ &N,
+      /* a = */ inv,
+      /* lda = */ &N,
+      /* ipiv = */ static_cast<int*>(ipiv.buffer.raw_ptr()),
+      /* info = */ &info);
+
+  if (info != 0) {
+    std::stringstream ss;
+    ss << "[Inverse::eval_cpu] LU factorization failed with error code "
+       << info;
+    throw std::runtime_error(ss.str());
+  }
+
+  static const int lwork_query = -1;
+  T workspace_size = 0;
+
+  // Compute workspace size.
+  getri<T>(
+      /* m = */ &N,
+      /* a = */ nullptr,
+      /* lda = */ &N,
+      /* ipiv = */ nullptr,
+      /* work = */ &workspace_size,
+      /* lwork = */ &lwork_query,
+      /* info = */ &info);
+
+  if (info != 0) {
+    std::stringstream ss;
+    ss << "[Inverse::eval_cpu] LU workspace calculation failed with error code "
+       << info;
+    throw std::runtime_error(ss.str());
+  }
+
+  const int lwork = workspace_size;
+  auto scratch = array::Data{allocator::malloc(sizeof(T) * lwork)};
+
+  // Compute inverse.
+  getri<T>(
+      /* m = */ &N,
+      /* a = */ inv,
+      /* lda = */ &N,
+      /* ipiv = */ static_cast<int*>(ipiv.buffer.raw_ptr()),
+      /* work = */ static_cast<T*>(scratch.buffer.raw_ptr()),
+      /* lwork = */ &lwork,
+      /* info = */ &info);
+
+  if (info != 0) {
+    std::stringstream ss;
+    ss << "[Inverse::eval_cpu] inversion failed with error code " << info;
+    throw std::runtime_error(ss.str());
+  }
+}
