+    b = transpose(b, {1, 0, 2});
+    auto out_gpu = add(a, b, Device::gpu);
+    auto out_cpu = add(a, b, Device::cpu);
+    auto expected =
+        array({0.0f, 3.0f, 5.0f, 8.0f, 6.0f, 9.0f, 11.0f, 14.0f}, {2, 2, 2});
