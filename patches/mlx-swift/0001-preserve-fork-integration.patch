+void* page_aligned_alloc(size_t num_bytes) {
+  static size_t page_size = sysconf(_SC_PAGESIZE);
+  void* buf;
+  if (posix_memalign(&buf, page_size, num_bytes)) {
+    return nullptr;
+  }
+  return buf;
+}
