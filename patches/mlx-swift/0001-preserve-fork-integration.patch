+# -*- coding: utf-8 -*-
+
+import os
+import subprocess
+
+# -- Project information -----------------------------------------------------
+
+project = "MLX C"
+copyright = "2023-2026, MLX Contributors"
+author = "MLX Contributors"
+version = "0.6.0"
+release = version
+
+# -- General configuration ---------------------------------------------------
+
+extensions = ["breathe"]
+breathe_projects = {"mlxc" : "../build/xml"}
+breathe_default_project = "mlxc"
