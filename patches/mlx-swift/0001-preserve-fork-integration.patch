+def replace_match_parenthesis(string, keyword, fun):
+    pattern = regex.compile(keyword + r"(\((?:[^()]++|(?1))++\))")
+    res = []
+    pos = 0
+    for m in pattern.finditer(string):
+        res.append(string[pos : m.start()])
+        res.append(fun(m[1][1:-1]))
+        pos = m.end()
+    res.append(string[pos:])
+    return "".join(res)
