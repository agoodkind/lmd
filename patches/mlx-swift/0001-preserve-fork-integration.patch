+      {array({0}), array({0.0f})},
+      array({1}, {1, 1, 1}),
+      {0, 1}));
+
+  // Index arrays must be broadcastable
+  CHECK_THROWS(scatter(
+      array({0}, {1, 1}),
+      {array({0, 0, 0}, {3}), array({0, 0}, {2})},
+      ones({3, 2, 1, 1}),
+      {0, 1}));
+
+  // Single element scatter
+  auto in = zeros({4}, float32);
+  auto inds = arange(2);
