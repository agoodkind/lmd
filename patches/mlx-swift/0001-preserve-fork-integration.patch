+    "use_repository_button": True,
+    "navigation_with_keys": False,
+    "logo": {
+        "image_light": "_static/mlx_logo.png",
+        "image_dark": "_static/mlx_logo_dark.png",
+    },
+}
+
+
+# -- Options for HTMLHelp output ---------------------------------------------
+
+htmlhelp_basename = "mlxc_doc"
