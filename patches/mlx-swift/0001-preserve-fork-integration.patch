+  // No dependence between input and output
+  {
+    auto fun = [](array in) { return array({1.0, 1.0}); };
+    auto out = jvp(fun, array(1.0f), array(1.0f)).second;
+    CHECK(array_equal(out, zeros({2})).item<bool>());
