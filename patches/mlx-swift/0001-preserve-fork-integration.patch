+    std::tie(loaded_weights, loaded_metadata) = load_gguf(file_path);
+    CHECK_EQ(loaded_metadata.size(), 1);
+    CHECK_EQ(loaded_metadata.count("test_arr"), 1);
+
+    loaded_arr = std::get<array>(loaded_metadata.at("test_arr"));
