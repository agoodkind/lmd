+def is_m1_mac():
+    if platform.system() != "Darwin":
+        return False
+    cmd = "sysctl -n machdep.cpu.brand_string"
+    cpu = subprocess.check_output(cmd, shell=True).decode().strip()
+    return cpu.startswith("Apple M1")
