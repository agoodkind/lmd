+    def test_module_attributes(self):
+        class Model(nn.Module):
+            def __init__(self):
+                super().__init__()
+                self.val = None
+                self.initialize()
+
+            def initialize(self):
+                self.val = mx.array(1.0)
+
+        model = Model()
+        self.assertTrue(mx.array_equal(model.val, mx.array(1.0)))
+
+        model.val = None
+        self.assertEqual(model.val, None)
