+  x = array(-2.0f);
+  CHECK(std::isnan(erfinv(x).item<float>()));
+
+  auto vals = {0.9f, 0.5f, 0.1f, -0.1f, -0.5f, -0.9f};
+  // Expected values are generated from scipy's error function:
+  //   python -c "import scipy.special as ss;
