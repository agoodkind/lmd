-// Opens a file for reading.
-auto open_file() -> file {
-  auto pipe = fmt::pipe();
-  pipe.write_end.write(file_content, std::strlen(file_content));
-  pipe.write_end.close();
-  return std::move(pipe.read_end);
-}
