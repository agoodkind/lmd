+ * Returns a partitioned copy of the flattened array
+ * such that the smaller kth elements are first.
+ **/
+array partition(const array& a, int kth, StreamOrDevice s /* = {} */) {
+  int size = a.size();
+  return partition(reshape(a, {size}, s), kth, 0, s);
