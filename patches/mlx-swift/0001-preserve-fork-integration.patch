+  }
+
+  // > 1D array throws
+  {
+    std::unordered_map<std::string, GGUFMetaData> original_metadata;
+    original_metadata.insert({"test_arr", array({1.0}, {1, 1})});
+    CHECK_THROWS(save_gguf(file_path, original_weights, original_metadata));
+  }
+
+  // empty array throws
