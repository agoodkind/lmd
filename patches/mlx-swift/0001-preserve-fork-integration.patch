+ *
+ * packed: uint8 with last dim 50 (D=128) or 100 (D=256)
+ * returns: float32 array with last dim = head_dim (128 or 256)
+ */
+MLX_API array turbo_decode_v(const array& packed, StreamOrDevice s = {});
+
+} // namespace mlx::core::fast
