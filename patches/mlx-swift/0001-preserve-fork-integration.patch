+constexpr float F8E4M3_MAX = 448.0f;
+constexpr float F4E2M1_MAX = 6.0f;
+constexpr size_t TMA_SHMEM_ALIGNMENT = 128;
+constexpr size_t BUFFS_NUM = 2;
