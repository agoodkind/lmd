+
+            r_np = npop(x1[:, :1], x2)
+            r_mlx = mlxop(y1[:, :1], y2)
+            mx.eval(r_mlx)
+            self.assertTrue(np.allclose(r_np, r_mlx, atol=atol))
+
+            r_np = npop(x1[:, :, :1], x2)
+            r_mlx = mlxop(y1[:, :, :1], y2)
+            mx.eval(r_mlx)
+            self.assertTrue(np.allclose(r_np, r_mlx, atol=atol))
+
+        x1 = np.maximum(np.random.rand(18, 28, 38), 0.1)
+        x2 = np.maximum(np.random.rand(18, 28, 38), 0.1)
+        y1 = mx.array(x1)
+        y2 = mx.array(x2)
+        mx.eval(y1, y2)
+        for op in [
+            "add",
